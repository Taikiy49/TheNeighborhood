local r=game.ServerScriptService.Neighborhood;local D=require(r.Services.PlayerDataService);assert(D.SessionOnly);local V=require(r.Services.VehicleService);local p=game.Players:GetPlayers()[1];local d=D:Get(p);local results={};for _,id in ipairs({'Bicycle','Compact','CoastGT'})do V:Remove(p);d.Vehicles.Owned=d.Vehicles.Owned or {};d.Vehicles.Owned[id]=require(game.ReplicatedStorage.Neighborhood.Shared.VehicleCatalog).Items[id].Price;d.Vehicles.Selected=id;local ok,why=V:Spawn(p);assert(ok,why);local c=V.Cars[p.UserId];local start=c.Body.Position;p.Character:PivotTo(c.Seat.CFrame*CFrame.new(0,2,0));task.wait(.3);c.Seat:Sit(p.Character.Humanoid);task.wait(.5);local high,low=0,100;for i=1,35 do V:Input(p,1,0);high=math.max(high,c.Body.Position.Y);low=math.min(low,c.Body.Position.Y);task.wait(.1)end;local distance=(c.Body.Position-start).Magnitude;table.insert(results,{Id=id,Distance=distance,Highest=high,Lowest=low});workspace:SetAttribute('DriveExitQA',game:GetService('HttpService'):JSONEncode(results));assert(high<5 and low>.5,'Unstable suspension '..id);assert(distance>25,'Blocked exit '..id);V:Remove(p);task.wait(.4)end;workspace:SetAttribute('DriveExitPassed',true)
local r=game.ServerScriptService.Neighborhood;local p=game.Players:GetPlayers()[1];local H=require(r.Services.HouseService);local h=H.ByPlayer[p.UserId];local I=require(r.Services.InteractionService);local room=h.Model.BuiltInInterior;local door=room.BedroomDoor;p.Character:PivotTo(h.Model.Foundation.CFrame*CFrame.new(-9,3.5,-2));task.wait(.5);local ok,why=I:Request(p,door,'BedroomDoor');assert(ok,why);task.wait(.5);p.Character.Humanoid:MoveTo(h.Model.Foundation.CFrame*Vector3.new(-9,3.5,5));task.wait(2);local pos=h.Model.Foundation.CFrame:PointToObjectSpace(p.Character.HumanoidRootPart.Position);assert(pos.Z>3,'Cannot enter bedroom');local S=require(r.StreetDressing);local count=0;for t=0,399 do local time=t/10;assert(not(S.Phase(time,'X')=='Green'and S.Phase(time,'Z')=='Green'));if time>=28 then assert(S.Phase(time,'X')=='Red'and S.Phase(time,'Z')=='Red')end;count+=1 end;local walkers=0;for _,actor in pairs(require(r.ResidentNeighbors).Actors)do if actor.Dog then walkers+=1;assert(actor.Model:GetAttribute('DogWalker'));assert(actor.Dog.PrimaryPart.CanCollide==false)end end;assert(walkers>=3);for _,house in ipairs(workspace.Neighborhood.Houses:GetChildren())do assert(not house.BuiltInInterior:FindFirstChild('HallPartition'));assert(house.BaseGarage.Floor.Size.X==20);assert(house.BuiltInInterior:FindFirstChild('BedroomDoor'))end;workspace:SetAttribute('RoomTrafficQA',game:GetService('HttpService'):JSONEncode({Bedrooms=12,Garages=12,DoorWalkThrough=true,SignalSamples=count,DogWalkers=walkers,Passed=true}))
